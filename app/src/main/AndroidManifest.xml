<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      spec：SAF 授权访问，不申请存储权限。
      SMB/WebDAV/Komga 走 TCP，必须有 INTERNET 权限（票 11）；缺了真机上 SMB 直接 EPERM 建连失败。
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- supportsRtl=false：导航抽屉仅从左缘滑出（spec 故事 53）；单页模式的右→左方向是应用内参数，不受影响 -->
    <!--
      usesCleartextTraffic：WebDAV/Komga 常是局域网明文 http 或自签 https（NAS 常态），
      targetSdk 34 下默认禁止明文，不放开则用户填的 http:// 地址必连不上（票 12 review P1）
    -->
    <!--
      启动图标：icon/roundIcon 都指向同一个 adaptive icon（issue #37）。
      没有单独一部位图圆图标——圆形遮罩由启动器对同一份三层自适应图标施加，
      另起一套 round 素材反而会变成两套图标。
    -->
    <application
        android:name=".ComicApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:usesCleartextTraffic="true"
        android:supportsRtl="false"
        android:theme="@style/Theme.ComicViewer">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          诊断日志导出（票 #113）：把应用私有目录里的 .txt 交给系统分享面板。
          authority 必须与 `DiagnosticsExport.AUTHORITY_SUFFIX` 拼出来的一致；exported=false + 只读授权。
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.diagnostics"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/diag_file_paths" />
        </provider>
    </application>

</manifest>
